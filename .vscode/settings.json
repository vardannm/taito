{
  "dart.flutterSdkPath": ".tools/flutter",
  "dart.env": {
    "PUB_CACHE": "${workspaceFolder}/.pub-cache",
    "ANDROID_HOME": "${workspaceFolder}/.tools/android-sdk",
    "GRADLE_USER_HOME": "${workspaceFolder}/.tools/gradle-cache"
  },
  "files.watcherExclude": {
    "**/.tools/**": true,
    "**/.pub-cache/**": true
  },
  "search.exclude": {
    "**/.tools": true,
    "**/.pub-cache": true,
    "**/build": true
  }
}