{
  "hosting": {
    "site": "gilt-ead46",
    "public": "release/privacy-site",
    "ignore": ["firebase.privacy.json", "**/*.md", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      }
    ]
  }
}
